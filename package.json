{
  "name": "display-switch",
  "version": "0.1.0",
  "description": "DisplaySwitch — 通过 DDC/CI 一键切换外接显示器输入源",
  "main": "./out/main/index.js",
  "author": "DisplaySwitch",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "DISPLAY_SWITCH_MOCK=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "gen:assets": "node scripts/gen-assets.mjs",
    "native:macos": "bash scripts/build-native-macos.sh",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:mac:local": "npm run gen:assets && npm run build && electron-builder --mac --arm64 --dir && bash scripts/make-dmg.sh",
    "build:win": "npm run build && electron-builder --win --x64",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
